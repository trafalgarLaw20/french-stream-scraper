# ──────────────────────────────────────────────────────────────────────
# French Stream Scraper — configuration (copier en .env et ajuster)
# ──────────────────────────────────────────────────────────────────────

# PostgreSQL
DATABASE_URL=postgres://USER:PASSWORD@localhost:5432/fss

# Pool de workers Playwright (P navigateurs en parallèle)
# 2 = bon compromis performance / risque de ban CF
WORKER_COUNT=2

# Scheduler — expressions cron (5 champs). Voir https://crontab.guru/
CRON_DISCOVER=0 3 * * *
CRON_METADATA=30 3 * * *
CRON_STREAM_TOP=0 * * * *
CRON_FULL_STREAM=0 4 * * 6

# Job stream-top : nombre de fiches (les plus populaires) rafraîchies chaque heure
STREAM_TOP_LIMIT=100

# API admin (POST /api/admin/crawl, GET /api/admin/runs…)
# Si laissé vide → authentification désactivée (mode dev local uniquement).
ADMIN_API_TOKEN=change-me-please

# Serveur HTTP
HTTP_PORT=3000
HTTP_HOST=127.0.0.1

# Mettre à 1 pour désactiver le scheduler au boot (mode debug)
DISABLE_SCHEDULER=0

# Environnement
NODE_ENV=production
