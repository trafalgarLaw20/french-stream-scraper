{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "strict": true,
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "noEmit": true,
    "types": ["node"]
  },
  "include": [
    "src/**/*.ts",
    "server/src/**/*.ts",
    "pg/**/*.ts",
    "crawler/**/*.ts",
    "scheduler/**/*.ts",
    "parser/**/*.ts",
    "scripts/**/*.ts",
    "drizzle.config.ts"
  ],
  "exclude": ["node_modules", "dist", "web"]
}
