{
  "name": "french-stream-scraper",
  "version": "0.1.0",
  "private": true,
  "description": "Scraper de données pour sites de streaming (french-stream.one) - extraction métadonnées + iframe + flux direct",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "bin": {
    "fss": "./dist/cli.js"
  },
  "scripts": {
    "dev:server": "tsx watch server/src/server.ts",
    "dev:web": "vite --config web/vite.config.ts",
    "dev": "concurrently -n server,web -c blue,magenta \"npm:dev:server\" \"npm:dev:web\"",
    "ui": "tsx server/src/server.ts",
    "start:prod": "NODE_ENV=production node_modules/.bin/tsx server/src/server.ts",
    "build:web": "vite build --config web/vite.config.ts",
    "scrape": "tsx src/cli.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/cli.js",
    "typecheck": "tsc -p tsconfig.server.json --noEmit",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:studio": "drizzle-kit studio",
    "db:from-sqlite": "tsx scripts/migrate-sqlite-to-pg.ts",
    "db:backup": "pg_dump --no-owner --clean --if-exists -Z 6 -d fss > data/backups/fss-$(date +%F).sql.gz",
    "discover": "tsx scripts/discover.ts",
    "crawl": "tsx scripts/crawl.ts"
  },
  "dependencies": {
    "@fastify/compress": "^9.0.0",
    "@fastify/cors": "^11.2.0",
    "@fastify/static": "^9.1.3",
    "better-sqlite3": "^12.10.1",
    "cheerio": "^1.0.0",
    "commander": "^12.1.0",
    "dotenv": "^17.4.2",
    "drizzle-orm": "^0.45.2",
    "fastify": "^5.8.5",
    "nanoid": "^5.1.11",
    "node-cron": "^4.2.1",
    "pg": "^8.21.0",
    "playwright": "^1.48.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.1",
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^22.9.0",
    "@types/node-cron": "^3.0.11",
    "@types/pg": "^8.20.0",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.2",
    "autoprefixer": "^10.5.0",
    "concurrently": "^10.0.3",
    "drizzle-kit": "^0.31.10",
    "hls.js": "^1.6.16",
    "postcss": "^8.5.15",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "tailwindcss": "^4.3.1",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3",
    "vite": "^8.0.16"
  }
}
