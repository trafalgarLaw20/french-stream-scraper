[Unit]
Description=French Stream Scraper — backup PostgreSQL
After=postgresql.service

[Service]
Type=oneshot
User=fss
Group=fss

# Dump compressé, rotaté par date. On conserve localement + on peut ajouter
# un rsync vers stockage externe via un autre service si besoin.
ExecStart=/bin/bash -c '/usr/bin/pg_dump --no-owner --clean --if-exists -Z 6 -d fss > /var/backups/fss/fss-$(date +%%F).sql.gz'

# Rotation : ne garder que les 14 derniers jours (exécuté après le dump).
ExecStartPost=/bin/bash -c '/usr/bin/find /var/backups/fss -name "fss-*.sql.gz" -mtime +14 -delete'

# Hardening.
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/backups/fss
ProtectKernelTunables=true
ProtectKernelModules=true

[Install]
WantedBy=multi-user.target
